{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "~/*": ["src/*"] },
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*.mjs"],
  "exclude": ["dist/**", "node_modules/**"]
}
