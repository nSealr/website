---
<figure class="system-map" aria-label="nSealr initial device paths">
  <svg viewBox="0 0 760 340" role="img" aria-labelledby="system-map-title system-map-desc">
    <title id="system-map-title">Shared Bridge and three initial device profiles</title>
    <desc id="system-map-desc">Nostr clients use Bridge for routing and verification. The initial device profiles are ESP32-S3 connected without a persistent identity vault, and Raspberry Pi and ESP32-P4 offline session signers. Each profile has independent release gates.</desc>
    <g class="system-map__links">
      <path d="M164 170 H288" />
      <path d="M420 170 C481 170 481 70 542 70" />
      <path d="M420 170 H542" />
      <path d="M420 170 C481 170 481 270 542 270" />
    </g>
    <g class="system-map__node system-map__node--client">
      <rect x="32" y="114" width="132" height="112" rx="8" />
      <text x="98" y="160">Nostr</text><text x="98" y="186">Client</text>
    </g>
    <g class="system-map__node system-map__node--companion">
      <rect x="288" y="82" width="132" height="176" rx="8" />
      <text x="354" y="160">Bridge</text><text x="354" y="186">Verifier</text>
    </g>
    <g class="system-map__node system-map__node--signer">
      <rect x="542" y="38" width="170" height="64" rx="8" />
      <text x="627" y="64">ESP32-S3</text><text x="627" y="86">USB session</text>
    </g>
    <g class="system-map__node system-map__node--signer">
      <rect x="542" y="138" width="170" height="64" rx="8" />
      <text x="627" y="164">Raspberry Pi</text><text x="627" y="186">QR session</text>
    </g>
    <g class="system-map__node system-map__node--signer">
      <rect x="542" y="238" width="170" height="64" rx="8" />
      <text x="627" y="264">ESP32-P4</text><text x="627" y="286">QR session</text>
    </g>
  </svg>
</figure>
<style>
  .system-map { margin: 0; padding-block: var(--space-6); max-width: 100%; overflow: hidden; }
  svg { display: block; width: 100%; height: auto; max-width: 100%; }
  .system-map__links path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .system-map__node rect {
    fill: var(--bg-elevated);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  .system-map__node text {
    font-family: var(--font-mono);
    fill: var(--fg-strong);
    font-size: 15px;
    font-weight: 600;
    text-anchor: middle;
  }
  .system-map__node--companion rect { stroke: var(--accent); }
  .system-map__node--signer rect { stroke: var(--accent-soft); }
  .system-map__node--client rect { stroke: var(--ok); }
</style>
