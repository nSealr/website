---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import SearchTrigger from './SearchTrigger.astro';
import logo from '~/assets/nsealr-logo.png';

const { pathname } = Astro.url;
const isActive = (p: string) => pathname === p || pathname.startsWith(p + '/');

interface NavLink { href: string; label: string; external?: boolean; }
const navLinks: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/system/', label: 'System' },
  { href: '/docs/', label: 'Docs' },
  { href: '/blog/', label: 'Blog' },
  { href: '/security/', label: 'Security' },
  { href: 'https://github.com/nSealr', label: 'GitHub ↗', external: true },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <Image
        class="brand__mark"
        src={logo}
        alt=""
        width={28}
        height={28}
        densities={[1, 2, 3]}
        format="webp"
        loading="eager"
      />
      <span class="brand__name">nSealr</span>
    </a>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      {navLinks.map(link => (
        link.external
          ? <a class="primary-nav__link primary-nav__link--ext" href={link.href} rel="noopener">{link.label}</a>
          : <a
              class={`primary-nav__link${isActive(link.href) ? ' is-active' : ''}`}
              href={link.href}
            >{link.label}</a>
      ))}
    </nav>

    <div class="site-header__utils">
      <SearchTrigger />
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        class="nav-toggle"
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    height: var(--header-height);
  }

  .brand {
    display: inline-flex; align-items: center; gap: var(--space-5);
    color: var(--fg-strong);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-base);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand__mark {
    width: 28px; height: 28px;
    border-radius: var(--radius-sm);
    display: block;
  }

  .primary-nav {
    display: flex; align-items: center; gap: var(--space-12);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    flex: 1;
    justify-content: flex-end;
  }
  .primary-nav__link {
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--tx-fast);
    white-space: nowrap;
  }
  .primary-nav__link:hover { color: var(--fg-strong); }
  .primary-nav__link.is-active { color: var(--accent-soft); }
  .primary-nav__link--ext:hover { color: var(--accent-soft); }

  .site-header__utils {
    display: flex; align-items: center; gap: var(--space-5);
    flex-shrink: 0;
  }

  .nav-toggle {
    display: none;
    width: 34px; height: 34px;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 0;
    align-items: center; justify-content: center;
    flex-direction: column; gap: var(--space-2);
  }
  .nav-toggle:hover { border-color: var(--accent); }
  .nav-toggle__bar {
    display: block; width: 14px; height: 2px;
    background: var(--fg); border-radius: 1px;
    transition: transform var(--tx-fast), opacity var(--tx-fast);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 720px) {
    .site-header__inner { gap: var(--space-5); }
    .nav-toggle { display: inline-flex; }

    .primary-nav {
      position: fixed;
      top: var(--header-height); left: 0; right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-2);
      flex-direction: column; align-items: stretch;
      gap: 0;
      padding: var(--space-4) 0;
      transform: translateY(-150%);
      transition: transform 180ms ease-out;
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
    }
    .primary-nav.is-open { transform: translateY(0); }
    .primary-nav__link {
      padding: var(--space-6) var(--gutter);
      border-bottom: 1px solid var(--border);
      font-size: var(--text-lg);
    }
    .primary-nav__link:last-child { border-bottom: 0; }
  }
</style>

<script>
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    nav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  }
</script>
