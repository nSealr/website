---
import { getDocsNav } from '~/lib/docs-nav';
interface Props { currentHref: string; }
const { currentHref } = Astro.props;
const nav = await getDocsNav();
---
<aside class="docs-sidebar" data-open="false" aria-label="Documentation sections">
  <button class="sidebar-toggle" type="button" aria-expanded="false" aria-controls="docs-sidebar-nav">
    <span class="label">Documentation</span>
    <span class="chevron" aria-hidden="true">▾</span>
  </button>
  <nav id="docs-sidebar-nav">
    {nav.map(group => (
      <section>
        <h3>{group.label}</h3>
        <ul>
          {group.items.map(item => (
            <li>
              <a href={item.href} class={item.href === currentHref ? 'current' : ''}>{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</aside>
<style>
  .docs-sidebar {
    font-family: var(--font-mono); font-size: 13px;
    padding: 12px 0;
    border-right: 1px solid var(--border);
  }
  .sidebar-toggle {
    display: none; /* hidden on desktop */
    width: 100%;
    align-items: center; justify-content: space-between;
    padding: 8px 12px;
    color: var(--fg-strong); font-weight: 600;
    font-family: var(--font-mono); font-size: 13px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    margin: 0 0 8px;
    cursor: pointer;
  }
  .sidebar-toggle .chevron { transition: transform 150ms; color: var(--accent-soft); }
  .docs-sidebar[data-open='true'] .sidebar-toggle .chevron { transform: rotate(180deg); }

  .docs-sidebar nav { padding: 12px 0; }
  .docs-sidebar section { padding: 8px 16px; }
  .docs-sidebar h3 {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--fg-muted); margin: 14px 0 6px;
  }
  .docs-sidebar ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .docs-sidebar a {
    color: var(--fg-muted); text-decoration: none;
    padding: 4px 8px; border-radius: var(--radius-sm); display: block;
  }
  .docs-sidebar a:hover { color: var(--fg-strong); background: var(--bg-elevated); }
  .docs-sidebar a.current { color: var(--accent-soft); background: var(--accent-bg); }

  /* Mobile: collapsible drawer; toggle visible, nav hidden unless data-open='true' */
  @media (max-width: 960px) {
    .docs-sidebar { border-right: 0; border-bottom: 1px solid var(--border); padding-bottom: 16px; }
    .sidebar-toggle { display: flex; }
    .docs-sidebar nav {
      max-height: 50vh; overflow-y: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--bg);
      padding: 4px 0;
    }
    .docs-sidebar[data-open='false'] nav { display: none; }
  }
</style>
<script>
  document.querySelectorAll('.docs-sidebar').forEach(wrap => {
    const btn = wrap.querySelector('.sidebar-toggle');
    btn?.addEventListener('click', () => {
      const open = wrap.getAttribute('data-open') === 'true';
      wrap.setAttribute('data-open', String(!open));
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
