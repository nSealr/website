---
import { getDocsNav } from '~/lib/docs-nav';

interface Props { currentHref: string; }
const { currentHref } = Astro.props;

const nav = await getDocsNav();
function containsCurrent(items: { href: string }[], current: string) {
  return items.some(i => i.href === current);
}
---
<aside class="sidebar sidebar--docs" data-open="false" aria-label="Documentation sections">
  <button class="sidebar__toggle" type="button" aria-expanded="false" aria-controls="docs-sidebar-nav">
    <span class="sidebar__toggle-label">Documentation</span>
    <span class="sidebar__chev" aria-hidden="true">▾</span>
  </button>
  <nav id="docs-sidebar-nav" class="sidebar__nav">
    {nav.map(group => (
      <section
        class="sidebar__group"
        data-section={group.section}
        data-default-open={containsCurrent(group.items, currentHref) ? 'true' : 'false'}
      >
        <button
          class="sidebar__group-toggle"
          type="button"
          aria-expanded={containsCurrent(group.items, currentHref) ? 'true' : 'false'}
        >
          <span class="sidebar__group-label">{group.label}</span>
          <span class="sidebar__group-count">{group.items.length}</span>
          <span class="sidebar__group-chev" aria-hidden="true">▾</span>
        </button>
        <ul class="sidebar__list">
          {group.items.map(item => (
            <li>
              <a
                class={`sidebar__link${item.href === currentHref ? ' is-current' : ''}`}
                href={item.href}
              >{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</aside>
<style>
  .sidebar {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    padding: var(--space-6) 0;
    border-right: 1px solid var(--border);
    position: sticky;
    top: var(--sticky-top);
    align-self: start;
    max-height: calc(100vh - var(--header-height) - var(--space-12));
    overflow-y: auto;
  }
  .sidebar__toggle {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    color: var(--fg-strong);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: var(--text-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    margin: 0 0 var(--space-4);
    cursor: pointer;
  }
  .sidebar__chev { transition: transform 150ms; color: var(--accent-soft); }
  .sidebar[data-open='true'] .sidebar__chev { transform: rotate(180deg); }

  .sidebar__nav { padding: var(--space-4) 0; }
  .sidebar__group { padding: var(--space-1) var(--space-6); }

  .sidebar__group-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: var(--space-4) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
  }
  .sidebar__group-toggle:hover { background: var(--bg-elevated); color: var(--fg-strong); }
  .sidebar__group-label { flex: 1; text-align: left; }
  .sidebar__group-count {
    font-size: var(--text-xxs);
    color: var(--fg-muted);
    text-transform: none;
    border: 1px solid var(--border);
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    font-weight: 500;
  }
  .sidebar__group-chev { transition: transform 150ms; color: var(--accent-soft); }
  .sidebar__group[aria-collapsed='true'] .sidebar__group-chev { transform: rotate(-90deg); }

  .sidebar__list {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 var(--space-3);
    display: grid;
    gap: var(--space-1);
    overflow: hidden;
    max-height: 1000px;
    transition: max-height var(--tx-base);
  }
  .sidebar__group[aria-collapsed='true'] .sidebar__list { max-height: 0; margin: 0; }

  .sidebar__link {
    color: var(--fg-muted);
    text-decoration: none;
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-sm);
    display: block;
    font-size: var(--text-md);
    text-transform: none;
    letter-spacing: 0;
  }
  .sidebar__link:hover { color: var(--fg-strong); background: var(--bg-elevated); text-decoration: none; }
  .sidebar__link.is-current {
    color: var(--accent-soft);
    background: var(--accent-bg);
    border-left: 2px solid var(--accent);
    padding-left: var(--space-5);
  }

  @media (max-width: 960px) {
    .sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      border-right: 0;
      border-bottom: 1px solid var(--border);
      padding-bottom: var(--space-8);
    }
    .sidebar__toggle { display: flex; }
    .sidebar__nav {
      max-height: 60vh;
      overflow-y: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--bg);
      padding: var(--space-2) 0;
    }
    .sidebar[data-open='false'] .sidebar__nav { display: none; }
  }
</style>
<script>
  document.querySelectorAll('.sidebar--docs').forEach(wrap => {
    const btn = wrap.querySelector('.sidebar__toggle');
    btn?.addEventListener('click', () => {
      const open = wrap.getAttribute('data-open') === 'true';
      wrap.setAttribute('data-open', String(!open));
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  document.querySelectorAll('.sidebar--docs .sidebar__group[data-section]').forEach(section => {
    const defaultOpen = section.getAttribute('data-default-open') === 'true';
    if (!defaultOpen) section.setAttribute('aria-collapsed', 'true');

    const toggle = section.querySelector('.sidebar__group-toggle')!;
    toggle.setAttribute('aria-expanded', String(defaultOpen));
    toggle.addEventListener('click', () => {
      const nowCollapsed = section.getAttribute('aria-collapsed') !== 'true';
      if (nowCollapsed) section.setAttribute('aria-collapsed', 'true');
      else section.removeAttribute('aria-collapsed');
      toggle.setAttribute('aria-expanded', String(!nowCollapsed));
    });
  });
</script>
