---
import { getCollection } from 'astro:content';

interface Props { currentHref?: string; }
const { currentHref } = Astro.props;

const CATEGORY_ORDER = ['release', 'research', 'tutorial', 'news'] as const;
const CATEGORY_LABEL: Record<typeof CATEGORY_ORDER[number], string> = {
  release: 'Releases',
  research: 'Research',
  tutorial: 'Tutorials',
  news: 'News',
};
const ITEMS_PER_CATEGORY = 5;

const posts = (await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const grouped = CATEGORY_ORDER.map(cat => {
  const all = posts.filter(p => p.data.category === cat);
  return {
    category: cat,
    label: CATEGORY_LABEL[cat],
    items: all.slice(0, ITEMS_PER_CATEGORY),
    overflow: Math.max(0, all.length - ITEMS_PER_CATEGORY),
    isCurrent: all.some(p => `/blog/${p.id}/` === currentHref),
  };
}).filter(g => g.items.length > 0);
---
<aside class="blog-sidebar" data-open="false" aria-label="Blog posts">
  <button class="sidebar-toggle" type="button" aria-expanded="false" aria-controls="blog-sidebar-nav">
    <span class="label">Blog</span>
    <span class="count">{posts.length}</span>
    <span class="chevron" aria-hidden="true">▾</span>
  </button>
  <nav id="blog-sidebar-nav">
    <section class="head-row">
      <a href="/blog/" class={currentHref === '/blog/' ? 'all-link current' : 'all-link'}>All posts ({posts.length})</a>
    </section>
    {grouped.map(group => (
      <section data-section={group.category} data-default-open={group.isCurrent ? 'true' : 'false'}>
        <button class="group-toggle" type="button" aria-expanded={group.isCurrent ? 'true' : 'false'}>
          <span class="group-label">{group.label}</span>
          <span class="group-count">{group.items.length + group.overflow}</span>
          <span class="group-chev" aria-hidden="true">▾</span>
        </button>
        <ul>
          {group.items.map(p => {
            const href = `/blog/${p.id}/`;
            return (
              <li>
                <a href={href} class={href === currentHref ? 'current' : ''}>
                  <span class="title">{p.data.title}</span>
                  <time datetime={p.data.publishedAt.toISOString()}>{p.data.publishedAt.toISOString().slice(0, 10)}</time>
                </a>
              </li>
            );
          })}
          {group.overflow > 0 && (
            <li class="more-row">
              <a class="more" href={`/blog/categories/${group.category}/`}>
                +{group.overflow} more in {group.label} →
              </a>
            </li>
          )}
        </ul>
      </section>
    ))}
    <section class="rss-row">
      <a href="/blog/tags/">Browse all tags →</a>
      <a href="/blog/rss.xml">RSS feed →</a>
    </section>
  </nav>
</aside>
<style>
  .blog-sidebar {
    font-family: var(--font-mono); font-size: 13px;
    padding: 12px 0;
    border-right: 1px solid var(--border);
    position: sticky;
    top: 76px;
    align-self: start;
    max-height: calc(100vh - 96px);
    overflow-y: auto;
  }
  .sidebar-toggle {
    display: none;
    width: 100%;
    align-items: center; gap: 8px;
    padding: 8px 12px;
    color: var(--fg-strong); font-weight: 600;
    font-family: var(--font-mono); font-size: 13px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    margin: 0 0 8px;
    cursor: pointer;
  }
  .sidebar-toggle .count {
    color: var(--fg-muted); font-size: 11px;
    border: 1px solid var(--border); padding: 1px 6px;
    border-radius: var(--radius-pill);
    margin-left: auto;
  }
  .sidebar-toggle .chevron { transition: transform 150ms; color: var(--accent-soft); }
  .blog-sidebar[data-open='true'] .sidebar-toggle .chevron { transform: rotate(180deg); }

  .blog-sidebar nav { padding: 8px 0; }
  .blog-sidebar section { padding: 2px 12px; }
  .blog-sidebar section.head-row { padding: 4px 16px 8px; }
  .all-link {
    display: block; padding: 6px 8px;
    color: var(--fg-strong); text-decoration: none;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font-weight: 600; font-size: 12px;
  }
  .all-link.current { color: var(--accent-soft); border-color: var(--accent); background: var(--accent-bg); }
  .all-link:hover { border-color: var(--accent); color: var(--accent-soft); }

  .group-toggle {
    display: flex; align-items: center; gap: 8px;
    width: 100%;
    background: transparent; border: 0; cursor: pointer;
    padding: 8px 6px;
    font-family: var(--font-mono); font-size: 11px;
    color: var(--fg-muted);
    text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
  }
  .group-toggle:hover { background: var(--bg-elevated); color: var(--fg-strong); }
  .group-toggle .group-label { flex: 1; text-align: left; }
  .group-toggle .group-count {
    font-size: 10px; color: var(--fg-muted); text-transform: none;
    border: 1px solid var(--border); padding: 0 6px;
    border-radius: var(--radius-pill); font-weight: 500;
  }
  .group-toggle .group-chev { transition: transform 150ms; color: var(--accent-soft); }
  section[aria-collapsed='true'] .group-chev { transform: rotate(-90deg); }

  .blog-sidebar ul {
    list-style: none; padding: 0; margin: 4px 0 6px;
    display: grid; gap: 6px;
    overflow: hidden;
    max-height: 1500px; transition: max-height 200ms;
  }
  section[aria-collapsed='true'] ul { max-height: 0; margin: 0; }

  .blog-sidebar li a {
    display: grid; gap: 2px;
    color: var(--fg-muted); text-decoration: none;
    padding: 6px 8px; border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
  }
  .blog-sidebar li a:hover {
    color: var(--fg-strong); background: var(--bg-elevated);
    border-left-color: var(--border-strong);
  }
  .blog-sidebar li a.current {
    color: var(--accent-soft); background: var(--accent-bg);
    border-left-color: var(--accent);
  }
  .blog-sidebar li .title {
    color: inherit; font-weight: 600;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    line-clamp: 2;
  }
  .blog-sidebar li time { color: var(--fg-muted); font-size: 11px; }
  .more-row a.more {
    display: block; padding: 4px 8px;
    color: var(--accent-soft); font-size: 11px;
    text-decoration: none; border-left: none;
  }
  .more-row a.more:hover { text-decoration: underline; }

  .blog-sidebar section.rss-row {
    padding-top: 16px; border-top: 1px dashed var(--border); margin-top: 12px;
    display: grid; gap: 4px;
  }
  .blog-sidebar section.rss-row a { color: var(--accent-soft); font-size: 12px; text-decoration: none; }
  .blog-sidebar section.rss-row a:hover { text-decoration: underline; }

  @media (max-width: 960px) {
    .blog-sidebar {
      position: static; max-height: none; overflow: visible;
      border-right: 0; border-bottom: 1px solid var(--border); padding-bottom: 16px;
    }
    .sidebar-toggle { display: flex; }
    .blog-sidebar nav {
      max-height: 60vh; overflow-y: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--bg);
      padding: 4px 0;
    }
    .blog-sidebar[data-open='false'] nav { display: none; }
  }
</style>
<script>
  document.querySelectorAll('.blog-sidebar').forEach(wrap => {
    const btn = wrap.querySelector('.sidebar-toggle');
    btn?.addEventListener('click', () => {
      const open = wrap.getAttribute('data-open') === 'true';
      wrap.setAttribute('data-open', String(!open));
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  const KEY = 'nsealr-blog-sidebar-collapsed';
  const collapsed = new Set<string>(JSON.parse(localStorage.getItem(KEY) || '[]'));

  document.querySelectorAll('.blog-sidebar section[data-section]').forEach(section => {
    const id = section.getAttribute('data-section')!;
    const defaultOpen = section.getAttribute('data-default-open') === 'true';
    const stored = localStorage.getItem(KEY);
    let isCollapsed: boolean;
    if (stored !== null) {
      isCollapsed = collapsed.has(id);
    } else {
      isCollapsed = !defaultOpen;
    }
    if (isCollapsed) section.setAttribute('aria-collapsed', 'true');

    const toggle = section.querySelector('.group-toggle')!;
    toggle.setAttribute('aria-expanded', String(!isCollapsed));
    toggle.addEventListener('click', () => {
      const nowCollapsed = section.getAttribute('aria-collapsed') !== 'true';
      if (nowCollapsed) {
        section.setAttribute('aria-collapsed', 'true');
        collapsed.add(id);
      } else {
        section.removeAttribute('aria-collapsed');
        collapsed.delete(id);
      }
      toggle.setAttribute('aria-expanded', String(!nowCollapsed));
      localStorage.setItem(KEY, JSON.stringify([...collapsed]));
    });
  });
</script>
