---
import { getCollection } from 'astro:content';
interface Props { family: string; }
const { family } = Astro.props;

const all = await getCollection('signers');
const entry = all.find(s => s.data.family === family);
if (!entry) throw new Error(`FeatureMatrix: unknown family "${family}"`);

const STATUS_VARIANT: Record<string, 'ok' | 'warn' | 'pending' | 'neutral'> = {
  implemented: 'ok', present: 'ok', partial: 'pending',
  planned: 'pending', research: 'pending',
  disabled_until_gates_pass: 'warn', disabled: 'warn',
  forbidden: 'warn', absent: 'warn',
  not_applicable: 'neutral', target: 'neutral',
  required: 'neutral', optional: 'neutral',
};
---
<div class="feature-matrix">
  <table>
    <thead>
      <tr>
        <th scope="col">Feature</th>
        <th scope="col">Target</th>
        <th scope="col">Current</th>
        <th scope="col">Contract</th>
      </tr>
    </thead>
    <tbody>
      {entry.data.capabilities.map(c => (
        <tr>
          <th scope="row"><code>{c.id}</code></th>
          <td><span class={`feature-matrix__badge feature-matrix__badge--${STATUS_VARIANT[c.target] ?? 'neutral'}`}>{c.target}</span></td>
          <td><span class={`feature-matrix__badge feature-matrix__badge--${STATUS_VARIANT[c.current] ?? 'neutral'}`}>{c.current}</span></td>
          <td>{c.contractId ? <code>{c.contractId}</code> : <span class="feature-matrix__dash">—</span>}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .feature-matrix { overflow-x: auto; margin: 1.4em 0; }
  table {
    width: 100%; border-collapse: collapse;
    font-size: var(--text-md);
    font-family: var(--font-mono);
  }
  th, td {
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  thead th {
    background: var(--bg-elevated);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }
  code { background: transparent; border: 0; padding: 0; font-size: var(--text-sm); color: var(--fg); }

  .feature-matrix__badge {
    display: inline-block;
    padding: 1px var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid;
    font-size: var(--text-xs);
  }
  .feature-matrix__badge--ok       { color: var(--ok);      border-color: color-mix(in oklab, var(--ok) 40%, transparent);      background: var(--ok-bg); }
  .feature-matrix__badge--warn     { color: var(--warn);    border-color: color-mix(in oklab, var(--warn) 40%, transparent);    background: var(--warn-bg); }
  .feature-matrix__badge--pending  { color: var(--pending); border-color: color-mix(in oklab, var(--pending) 40%, transparent); background: var(--pending-bg); }
  .feature-matrix__badge--neutral  { color: var(--fg-muted); border-color: var(--border); background: transparent; }

  .feature-matrix__dash { color: var(--fg-muted); }
</style>
