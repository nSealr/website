---
---
<button id="search-trigger" type="button" class="search-trigger" aria-label="Open search">
  <span>Search</span>
  <kbd>⌘K</kbd>
</button>
<div id="search-modal" class="search-modal" hidden>
  <div class="search-modal__panel" role="dialog" aria-modal="true" aria-label="Search">
    <header class="search-modal__head">
      <span class="eyebrow-small">Search</span>
      <button id="search-close" type="button" class="search-modal__close" aria-label="Close search">
        <span class="search-modal__esc">Esc</span>
      </button>
    </header>
    <div id="pagefind-search" class="search-modal__results"></div>
  </div>
</div>

<style>
  .search-trigger {
    display: inline-flex; align-items: center; gap: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .search-trigger:hover { border-color: var(--accent); color: var(--fg-strong); }
  .search-trigger kbd {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
  }

  .search-modal {
    position: fixed; inset: 0;
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    backdrop-filter: blur(4px);
    z-index: 100;
    display: grid;
    place-items: center;
    padding: var(--space-8);
    overscroll-behavior: contain;
  }
  .search-modal[hidden] { display: none; }

  .search-modal__panel {
    width: min(640px, 100%);
    max-height: calc(100vh - var(--space-16));
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 0 var(--space-8) var(--space-8);
    box-shadow: var(--shadow-2);
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .search-modal__head {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-6) 0 var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .search-modal__close {
    background: transparent; color: var(--fg-muted);
    border: 0; padding: 0; cursor: pointer;
    display: inline-flex; align-items: center;
  }
  .search-modal__esc {
    font-family: var(--font-mono); font-size: var(--text-xs);
    padding: var(--space-1) var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
  }
  .search-modal__close:hover .search-modal__esc {
    color: var(--accent-soft); border-color: var(--accent);
  }
  .search-modal__results {
    margin-top: var(--space-4);
    min-height: 80px;
    overflow-y: auto;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* Pagefind UI theming via its own CSS custom properties + overrides */
  .search-modal__results :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border-strong);
    --pagefind-ui-tag: var(--bg-elevated);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-sm);
    --pagefind-ui-image-border-radius: var(--radius-sm);
    --pagefind-ui-font: var(--font-mono);
    color: var(--fg);
  }
  .search-modal__results :global(.pagefind-ui__form::before) {
    background-color: var(--accent-soft) !important;
  }
  .search-modal__results :global(.pagefind-ui__search-input) {
    background: var(--bg) !important;
    color: var(--fg) !important;
    border: 1px solid var(--border-strong) !important;
    border-radius: var(--radius-md) !important;
    font-family: var(--font-mono) !important;
    font-size: var(--text-md) !important;
    padding: var(--space-5) var(--space-12) !important;
  }
  .search-modal__results :global(.pagefind-ui__search-input:focus) {
    outline: 2px solid var(--accent-soft) !important;
    outline-offset: 2px;
  }
  .search-modal__results :global(.pagefind-ui__search-clear) {
    background: transparent !important;
    color: var(--fg-muted) !important;
    border: 1px solid var(--border-strong) !important;
    border-radius: var(--radius-sm) !important;
    padding: var(--space-1) var(--space-4) !important;
    font-family: var(--font-mono) !important;
    font-size: var(--text-xs) !important;
    font-weight: 600 !important;
    text-transform: lowercase;
    cursor: pointer;
  }
  .search-modal__results :global(.pagefind-ui__search-clear:hover) {
    color: var(--accent-soft) !important;
    border-color: var(--accent) !important;
  }
  .search-modal__results :global(.pagefind-ui__result) {
    border-bottom: 1px solid var(--border) !important;
    padding: var(--space-6) 0 !important;
  }
  .search-modal__results :global(.pagefind-ui__result-link) {
    color: var(--fg-strong) !important;
    font-family: var(--font-mono) !important;
    font-size: var(--text-base) !important;
    text-decoration: none !important;
  }
  .search-modal__results :global(.pagefind-ui__result-link:hover) {
    color: var(--accent-soft) !important;
  }
  .search-modal__results :global(.pagefind-ui__result-excerpt) {
    color: var(--fg-muted) !important;
    font-size: var(--text-md) !important;
  }
  .search-modal__results :global(mark) {
    background: var(--accent-bg) !important;
    color: var(--accent-soft) !important;
    padding: 0 2px;
  }
  .search-modal__results :global(.pagefind-ui__message) {
    color: var(--fg-muted) !important;
    font-family: var(--font-mono) !important;
    font-size: var(--text-sm) !important;
  }
</style>

<script>
  const trigger = document.getElementById('search-trigger');
  const modal = document.getElementById('search-modal');
  const closeBtn = document.getElementById('search-close');
  const target = document.getElementById('pagefind-search');
  let pagefindMounted = false;
  let cssMounted = false;

  function mountPagefindCss() {
    if (cssMounted) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);
    cssMounted = true;
  }

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`failed to load ${src}`));
      document.head.appendChild(s);
    });
  }

  async function openModal() {
    if (!modal) return;
    modal.hidden = false;
    document.body.classList.add('is-modal-open');
    if (!pagefindMounted) {
      mountPagefindCss();
      try {
        await loadScript('/pagefind/pagefind-ui.js');
        // @ts-expect-error PagefindUI is attached to window at runtime
        new window.PagefindUI({
          element: '#pagefind-search',
          showImages: false,
          resetStyles: false,
        });
      } catch {
        if (target) {
          target.innerHTML = `
            <p style="color: var(--fg-muted); font-family: var(--font-mono); font-size: 13px; margin: 8px 0 0;">
              Search index is built at deploy time. In dev, run
              <code style="color: var(--accent-soft);">pnpm run build &amp;&amp; pnpm run preview</code>
              to try it locally.
            </p>`;
        }
      }
      pagefindMounted = true;
    }
    // Focus the input once Pagefind has injected it.
    requestAnimationFrame(() => {
      const input = modal.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
      input?.focus();
    });
  }

  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.classList.remove('is-modal-open');
  }

  trigger?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openModal();
    }
    if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
  });
</script>
