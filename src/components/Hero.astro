---
import { Image } from 'astro:assets';
import logo from '~/assets/nsealr-logo.png';
---
<section class="hero container">
  <div>
    <p class="eyebrow">// your identity. your device.</p>
    <h1>Keep your<br /><em>Nostr key</em><br />offline.</h1>
    <p class="lead">Create or recover your identity. Read the request on your device.
      Sign it with a touch. Share the result by QR.</p>
    <div class="actions">
      <a class="primary" href="/connect/">Open companion →</a>
      <a href="/downloads/">Browser extensions</a>
      <a href="https://github.com/nSealr/nsealr">Explore the source ↗</a>
    </div>
    <p class="detail">open source · ESP32-P4 · QR exchange</p>
  </div>
  <figure><Image src={logo} alt="The nSealr seal holding a Nostr envelope"
    width={520} height={520} densities={[1, 2]} format="webp" loading="eager" /></figure>
</section>
<style>
.hero{padding-block:clamp(40px,8vw,96px);display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
h1{font:700 var(--text-hero)/1.04 var(--font-mono);letter-spacing:-.045em;margin:18px 0 24px;color:var(--fg-strong)}
em{font-style:normal;color:var(--accent-soft)}.lead{max-width:40ch;line-height:1.6}
.actions{display:flex;flex-wrap:wrap;align-items:center;gap:24px;margin-top:32px;font-family:var(--font-mono);font-size:14px}
.primary{background:var(--accent);color:white;padding:14px 20px;border-radius:var(--radius-sm);border:1px solid transparent}
.primary:hover{text-decoration:none;border-color:var(--accent-soft)}.detail{margin-top:28px;color:var(--fg-muted);font:12px var(--font-mono)}
figure{margin:0}figure img{width:100%;height:auto;max-width:520px;margin:auto}
@media(max-width:720px){.hero{grid-template-columns:1fr;gap:24px;padding-top:36px}.hero figure{max-width:320px;margin:auto}.lead{font-size:18px}}
</style>
