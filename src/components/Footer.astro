---
import { Image } from 'astro:assets';
import logo from '~/assets/nsealr-logo.png';

const year = new Date().getFullYear();

const repos = [
  { href: 'https://github.com/nSealr/nsealr', label: 'Source' },
  { href: 'https://github.com/nSealr/nsealr/issues', label: 'Issues' },
  { href: 'https://github.com/nSealr/.github', label: 'Community' },
];
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__line">
        <Image
          class="site-footer__mark"
          src={logo}
          alt=""
          width={22}
          height={22}
          densities={[1, 2, 3]}
          format="webp"
          loading="lazy"
        />
        nSealr — your Nostr key, offline
      </p>
      <p class="muted">
        Open source. Built for Nostr.
      </p>
    </div>

    <nav class="site-footer__repos" aria-label="Repositories">
      {repos.map(r => <a href={r.href}>{r.label}</a>)}
    </nav>

    <p class="muted site-footer__copy">© {year} nSealr contributors.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-40);
    padding: var(--space-16) 0;
  }
  .site-footer__inner { display: grid; gap: var(--space-10); }

  .site-footer__line {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    margin: 0 0 var(--space-2);
    display: inline-flex; align-items: center; gap: var(--space-4);
  }
  .site-footer__mark {
    width: 22px; height: 22px;
    border-radius: var(--radius-sm);
    display: inline-block;
  }
  .muted { color: var(--fg-muted); margin: 0; font-size: var(--text-base); }

  .site-footer__repos {
    display: flex; flex-wrap: wrap; gap: var(--space-7);
    font-family: var(--font-mono); font-size: var(--text-md);
  }
  .site-footer__repos a { color: var(--fg-muted); text-decoration: none; }
  .site-footer__repos a:hover { color: var(--accent-soft); }

  .site-footer__copy { font-size: var(--text-sm); }
</style>
