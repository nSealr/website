---
interface Link {
  href: string;
  title: string;
  label?: string;
}
interface Props {
  prev?: Link;
  next?: Link;
}
const { prev, next } = Astro.props;
const layout = prev && next ? 'both' : prev ? 'prev' : next ? 'next' : null;
---
{layout && (
  <nav class={`prevnext prevnext--${layout}`} aria-label="Pagination">
    {prev && (
      <a class="prevnext__cell prevnext__cell--prev" href={prev.href}>
        <span class="prevnext__dir" aria-hidden="true">←</span>
        <span class="prevnext__meta">
          <span class="prevnext__label">{prev.label ?? 'Previous'}</span>
          <span class="prevnext__title">{prev.title}</span>
        </span>
      </a>
    )}
    {next && (
      <a class="prevnext__cell prevnext__cell--next" href={next.href}>
        <span class="prevnext__meta">
          <span class="prevnext__label">{next.label ?? 'Next'}</span>
          <span class="prevnext__title">{next.title}</span>
        </span>
        <span class="prevnext__dir" aria-hidden="true">→</span>
      </a>
    )}
  </nav>
)}
<style>
  .prevnext {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-20);
  }
  .prevnext--both { grid-template-columns: 1fr 1fr; }
  .prevnext--prev { grid-template-columns: minmax(0, 360px); justify-content: start; }
  .prevnext--next { grid-template-columns: minmax(0, 360px); justify-content: end; }

  .prevnext__cell {
    display: flex; align-items: center; gap: var(--space-6);
    text-decoration: none;
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-7) var(--space-8);
    background: var(--bg-elevated);
    transition: border-color var(--tx-fast), transform var(--tx-fast);
    min-height: 64px;
  }
  .prevnext__cell:hover { border-color: var(--accent); transform: translateY(-1px); }
  .prevnext__cell--next { justify-content: flex-end; text-align: right; }

  .prevnext__meta { display: grid; gap: var(--space-1); min-width: 0; }
  .prevnext__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .prevnext__title {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--fg-strong);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
  }
  .prevnext__dir {
    color: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    flex-shrink: 0;
    transition: transform var(--tx-fast);
  }
  .prevnext__cell--prev:hover .prevnext__dir { transform: translateX(-3px); }
  .prevnext__cell--next:hover .prevnext__dir { transform: translateX(3px); }

  @media (max-width: 560px) {
    .prevnext--both,
    .prevnext--prev,
    .prevnext--next { grid-template-columns: 1fr; justify-content: stretch; }
  }
</style>
