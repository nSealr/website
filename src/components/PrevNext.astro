---
interface Link {
  href: string;
  title: string;
  label?: string; // eyebrow shown above the title
}
interface Props {
  prev?: Link;
  next?: Link;
}
const { prev, next } = Astro.props;
const layout = prev && next ? 'both' : prev ? 'prev-only' : next ? 'next-only' : null;
---
{layout && (
  <nav class={`prevnext layout-${layout}`} aria-label="Pagination">
    {prev && (
      <a class="cell prev" href={prev.href}>
        <span class="dir" aria-hidden="true">←</span>
        <span class="meta">
          <span class="eyebrow">{prev.label ?? 'Previous'}</span>
          <span class="title">{prev.title}</span>
        </span>
      </a>
    )}
    {next && (
      <a class="cell next" href={next.href}>
        <span class="meta">
          <span class="eyebrow">{next.label ?? 'Next'}</span>
          <span class="title">{next.title}</span>
        </span>
        <span class="dir" aria-hidden="true">→</span>
      </a>
    )}
  </nav>
)}
<style>
  .prevnext {
    display: grid; gap: 12px;
    margin-top: 40px;
  }
  .prevnext.layout-both { grid-template-columns: 1fr 1fr; }
  .prevnext.layout-prev-only { grid-template-columns: minmax(0, 360px); justify-content: start; }
  .prevnext.layout-next-only { grid-template-columns: minmax(0, 360px); justify-content: end; }

  .cell {
    display: flex; align-items: center; gap: 12px;
    text-decoration: none; color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    background: var(--bg-elevated);
    transition: border-color 120ms, transform 120ms;
    min-height: 64px;
  }
  .cell:hover { border-color: var(--accent); transform: translateY(-1px); }
  .cell.next { justify-content: flex-end; text-align: right; }
  .cell .meta { display: grid; gap: 2px; min-width: 0; }
  .cell .eyebrow {
    font-family: var(--font-mono); font-size: 11px;
    color: var(--fg-muted);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .cell .title {
    font-family: var(--font-mono); font-size: 14px;
    color: var(--fg-strong); font-weight: 600;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    display: block;
  }
  .cell .dir {
    color: var(--accent-soft); font-family: var(--font-mono);
    font-size: 18px; flex-shrink: 0;
    transition: transform 120ms;
  }
  .cell.prev:hover .dir { transform: translateX(-3px); }
  .cell.next:hover .dir { transform: translateX(3px); }
  @media (max-width: 560px) {
    .prevnext.layout-both { grid-template-columns: 1fr; }
    .prevnext.layout-prev-only,
    .prevnext.layout-next-only { grid-template-columns: 1fr; justify-content: stretch; }
  }
</style>
