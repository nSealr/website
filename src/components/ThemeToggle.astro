---
---
<div class="theme-toggle" role="group" aria-label="Color theme">
  <button type="button" class="theme-toggle__btn" data-theme-value="light" aria-label="Light theme">
    <span aria-hidden="true">☀</span>
  </button>
  <button type="button" class="theme-toggle__btn" data-theme-value="system" aria-label="System theme">
    <span aria-hidden="true">⊙</span>
  </button>
  <button type="button" class="theme-toggle__btn" data-theme-value="dark" aria-label="Dark theme">
    <span aria-hidden="true">☾</span>
  </button>
</div>
<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    padding: 2px;
  }
  .theme-toggle__btn {
    display: inline-grid;
    place-items: center;
    width: 26px; height: 26px;
    background: transparent;
    border: 0;
    color: var(--fg-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
    font-size: var(--text-md);
    line-height: 1;
    transition: background var(--tx-fast), color var(--tx-fast);
  }
  .theme-toggle__btn:hover { color: var(--fg-strong); }
  .theme-toggle__btn[aria-pressed='true'] {
    background: var(--accent-bg);
    color: var(--accent-soft);
  }
</style>
<script>
  type ThemePref = 'light' | 'dark' | 'system';

  function getStoredPref(): ThemePref {
    try {
      const s = localStorage.getItem('theme');
      if (s === 'light' || s === 'dark') return s;
    } catch {}
    return 'system';
  }

  function applyPref(pref: ThemePref) {
    let effective: 'light' | 'dark';
    if (pref === 'system') {
      effective = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    } else {
      effective = pref;
    }
    document.documentElement.setAttribute('data-theme', effective);

    try {
      if (pref === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', pref);
    } catch {}
  }

  function syncButtons() {
    const pref = getStoredPref();
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle__btn').forEach(btn => {
      const v = btn.getAttribute('data-theme-value');
      btn.setAttribute('aria-pressed', String(v === pref));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const v = btn.getAttribute('data-theme-value') as ThemePref;
      applyPref(v);
      syncButtons();
    });
  });

  // Reflect OS changes while user is on 'system'.
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (getStoredPref() === 'system') applyPref('system');
  });

  syncButtons();
</script>
