---
<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle color theme"
  title="Theme: system"
>
  <span class="theme-toggle__icon theme-toggle__icon--system" aria-hidden="true">⊙</span>
  <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">☀</span>
  <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">☾</span>
</button>
<style>
  .theme-toggle {
    width: 34px; height: 34px;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    padding: 0;
    position: relative;
    transition: border-color var(--tx-fast);
  }
  .theme-toggle:hover { border-color: var(--accent); }
  .theme-toggle__icon {
    position: absolute;
    font-size: var(--text-lg);
    line-height: 1;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity var(--tx-fast), transform var(--tx-fast);
  }
  .theme-toggle[data-pref='system'] .theme-toggle__icon--system,
  .theme-toggle[data-pref='light']  .theme-toggle__icon--light,
  .theme-toggle[data-pref='dark']   .theme-toggle__icon--dark {
    opacity: 1;
    transform: scale(1);
  }
</style>
<script>
  type ThemePref = 'system' | 'light' | 'dark';
  const ORDER: ThemePref[] = ['system', 'light', 'dark'];

  const btn = document.getElementById('theme-toggle');

  function readPref(): ThemePref {
    try {
      const s = localStorage.getItem('theme');
      if (s === 'light' || s === 'dark') return s;
    } catch {}
    return 'system';
  }

  function applyPref(pref: ThemePref) {
    let effective: 'light' | 'dark';
    if (pref === 'system') {
      effective = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    } else {
      effective = pref;
    }
    document.documentElement.setAttribute('data-theme', effective);

    try {
      if (pref === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', pref);
    } catch {}

    btn?.setAttribute('data-pref', pref);
    btn?.setAttribute('title', `Theme: ${pref}`);
  }

  // Initial sync (theme-init.ts has already painted; we just label the button).
  applyPref(readPref());

  btn?.addEventListener('click', () => {
    const cur = readPref();
    const next = ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length];
    applyPref(next);
  });

  // Track OS preference while user is on 'system'.
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (readPref() === 'system') applyPref('system');
  });
</script>
