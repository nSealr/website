---
import StatusPill from './StatusPill.astro';
interface Props {
  family: string;
  displayName: string;
  tagline: string;
  maturity: string;
  href: string;
}
const { family, displayName, tagline, maturity, href } = Astro.props;
const variant: 'ok' | 'pending' | 'neutral' =
  maturity === 'alpha' || maturity === 'beta' ? 'ok'
    : maturity === 'prototype' ? 'pending'
    : 'neutral';
---
<a class="signer-card" href={href} data-family={family}>
  <div class="signer-card__head">
    <span class="signer-card__name">{displayName}</span>
    <StatusPill variant={variant}>{maturity}</StatusPill>
  </div>
  <p class="signer-card__tag">{tagline}</p>
  <span class="signer-card__arrow" aria-hidden="true">→</span>
</a>
<style>
  .signer-card {
    display: block;
    padding: var(--space-8) var(--space-10);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    text-decoration: none;
    color: var(--fg);
    transition: border-color var(--tx-fast), transform var(--tx-fast);
    position: relative;
  }
  .signer-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .signer-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-3);
  }
  .signer-card__name {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--fg-strong);
    font-weight: 700;
    line-height: 1.3;
  }
  .signer-card__tag {
    color: var(--fg-muted);
    font-size: var(--text-md);
    margin: 0;
  }
  .signer-card__arrow {
    position: absolute;
    right: var(--space-10);
    bottom: var(--space-7);
    color: var(--accent-soft);
    font-family: var(--font-mono);
  }
</style>
