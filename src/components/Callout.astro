---
type Variant = 'info' | 'warn' | 'danger';
interface Props { variant?: Variant; title?: string; }
const { variant = 'info', title } = Astro.props;
---
<aside class={`callout callout--${variant}`} role={variant === 'info' ? 'note' : 'alert'}>
  {title && <p class="callout__title">{title}</p>}
  <div class="callout__body"><slot /></div>
</aside>
<style>
  .callout {
    border-left: 3px solid var(--accent);
    background: var(--accent-bg);
    padding: var(--space-6) var(--space-8);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: 1.4em 0;
  }
  .callout--warn   { border-color: var(--pending); background: var(--pending-bg); }
  .callout--danger { border-color: var(--warn);    background: var(--warn-bg); }
  .callout__title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-2);
    color: var(--fg-strong);
  }
  .callout__body :global(p) { margin: 0; }
  .callout__body :global(p + p) { margin-top: var(--space-4); }
</style>
