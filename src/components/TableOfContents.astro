---
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; }
const { headings } = Astro.props;
const items = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---
{items.length > 0 && (
  <aside class="toc" data-open="false" aria-label="On this page">
    <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="toc-nav">
      <span class="label">On this page</span>
      <span class="chevron" aria-hidden="true">▾</span>
    </button>
    <nav id="toc-nav">
      <ul>
        {items.map(h => (
          <li class={`d-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ul>
    </nav>
  </aside>
)}
<style>
  .toc {
    position: sticky; top: 80px;
    font-family: var(--font-mono); font-size: 12px;
    padding: 24px 16px 24px 0;
  }
  .toc-toggle {
    display: none;
    width: 100%;
    align-items: center; justify-content: space-between;
    padding: 8px 12px;
    color: var(--fg-strong); font-weight: 600;
    font-family: var(--font-mono); font-size: 13px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    margin: 0 0 8px;
    cursor: pointer;
  }
  .toc-toggle .chevron { transition: transform 150ms; color: var(--accent-soft); }
  .toc[data-open='true'] .toc-toggle .chevron { transform: rotate(180deg); }

  .toc nav { padding-left: 0; }
  .toc ul {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 4px;
    border-left: 1px solid var(--border);
  }
  .toc li { padding-left: 12px; }
  .toc li.d-3 { padding-left: 24px; opacity: 0.85; }
  .toc a {
    color: var(--fg-muted); text-decoration: none;
    display: block; padding: 2px 0;
  }
  .toc a:hover { color: var(--accent-soft); }

  @media (max-width: 960px) {
    .toc {
      position: static; top: auto;
      padding: 16px 0 8px;
      margin-top: 32px;
      border-top: 1px solid var(--border);
    }
    .toc-toggle { display: flex; }
    .toc nav { padding-top: 8px; }
    .toc[data-open='false'] nav { display: none; }
  }
</style>
<script>
  document.querySelectorAll('.toc').forEach(wrap => {
    const btn = wrap.querySelector('.toc-toggle');
    btn?.addEventListener('click', () => {
      const open = wrap.getAttribute('data-open') === 'true';
      wrap.setAttribute('data-open', String(!open));
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
