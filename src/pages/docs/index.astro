---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDocsNav } from '~/lib/docs-nav';

const nav = await getDocsNav();
const SECTION_DESC: Record<string, string> = {
  'getting-started': 'Read this first: what nSealr is, who it is for, and how a signing request flows from client to signer.',
  'guides': 'Hands-on build, flash, and bring-up walkthroughs for the hardware lines.',
  'signers': 'Per-solution status pages with maturity, capability matrix, and shared contract IDs.',
  'specs': 'Reference for the protocol contracts: event canonicalization, QR envelopes, transports.',
  'security': 'Trust boundaries, threat model, and the safety contracts the project enforces today.',
};

// Heavy sections (≥4 items) span two columns so their list does not collapse to a tiny column.
function spanFor(count: number): 1 | 2 {
  return count >= 4 ? 2 : 1;
}
---
<BaseLayout
  title="Docs — nSealr"
  description="Documentation, build guides, per-solution status, specs reference, and security model for nSealr."
>
  <section class="container page">
    <p class="eyebrow">// docs</p>
    <h1 class="page__title">Documentation.</h1>
    <p class="lead">
      Build guides, per-solution status, protocol references, and the
      security model. Every signer solution shares the same
      <code>contract_id</code>s from
      <a href="https://github.com/nSealr/specs">nSealr/specs</a>.
    </p>

    <div class="section-grid">
      {nav.filter(g => g.items.length > 0).map(group => (
        <article class={`surface section-card section-card--span-${spanFor(group.items.length)}`}>
          <header>
            <div class="section-card__head">
              <span class="eyebrow-small">{group.section}</span>
              <span class="section-card__count" aria-label={`${group.items.length} pages`}>
                {group.items.length} {group.items.length === 1 ? 'page' : 'pages'}
              </span>
            </div>
            <h2 class="section-card__title">{group.label}</h2>
            <p class="section-card__desc">{SECTION_DESC[group.section]}</p>
          </header>
          <ul class="section-card__list">
            {group.items.map(item => (
              <li>
                <a href={item.href}>
                  <span class="section-card__name">{item.title}</span>
                  <span class="section-card__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding-block: var(--space-20); }
  .page__title {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-h1);
    margin: var(--space-4) 0 var(--space-7);
  }
  .lead { font-size: var(--text-xl); margin: 0 0 var(--space-16); }
  .lead code {
    background: var(--accent-bg);
    color: var(--accent-soft);
    border: 0;
    padding: 1px var(--space-3);
    border-radius: var(--radius-sm);
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-8);
    grid-auto-flow: dense;
  }
  @media (min-width: 880px) {
    .section-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .section-card--span-2 { grid-column: span 2; }
  }

  .section-card {
    padding: var(--space-12) var(--space-12);
    display: flex; flex-direction: column;
    gap: var(--space-8);
    transition: border-color var(--tx-fast);
  }
  .section-card:hover { border-color: var(--border-strong); }

  .section-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-2);
  }
  .section-card__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    border: 1px solid var(--border);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
  }

  .section-card__title {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-section);
    margin: 0 0 var(--space-4);
    letter-spacing: -0.01em;
  }
  .section-card__desc { color: var(--fg-muted); margin: 0; font-size: var(--text-base); max-width: 56ch; }

  .section-card__list {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: var(--space-1);
  }
  .section-card--span-2 .section-card__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-1) var(--space-8);
  }
  @media (max-width: 720px) {
    .section-card--span-2 .section-card__list { grid-template-columns: 1fr; }
  }

  .section-card__list li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--fg);
    text-decoration: none;
    padding: var(--space-4) 0;
    border-bottom: 1px dashed var(--border);
  }
  .section-card__list li:last-child a { border-bottom: 0; }
  .section-card__list li a:hover { color: var(--accent-soft); }
  .section-card__list li a:hover .section-card__arrow {
    color: var(--accent);
    transform: translateX(2px);
  }
  .section-card__arrow {
    color: var(--accent-soft);
    transition: transform var(--tx-fast), color var(--tx-fast);
  }
  .section-card__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
