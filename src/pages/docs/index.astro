---
import BaseLayout from '~/layouts/BaseLayout.astro';
import {getDocsNav} from '~/lib/docs-nav';
const items=(await getDocsNav()).flatMap(g=>g.items);
---
<BaseLayout title="Guide — nSealr" description="Set up your identity, sign requests and connect a Nostr client.">
 <section class="container guide"><p class="eyebrow">// guide</p><h1>Use nSealr.</h1>
  <p class="lead">Your identity, your device, your choice.</p>
  <div>{items.map(item=><a class="surface" href={item.href}><span>{item.title}</span><span aria-hidden="true">→</span></a>)}</div>
 </section>
</BaseLayout>
<style>.guide{padding-block:48px;max-width:900px}h1{font:600 var(--text-h1) var(--font-mono)}.guide>div{display:grid;gap:12px;margin-top:32px}.surface{display:flex;justify-content:space-between;padding:22px;font:16px var(--font-mono);color:var(--fg-strong)}.surface:hover{border-color:var(--accent);text-decoration:none}</style>
