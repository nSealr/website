---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '~/layouts/DocsLayout.astro';
import { getDocsNav } from '~/lib/docs-nav';
export async function getStaticPaths() {
  return (await getCollection('docs')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
interface Props { entry: CollectionEntry<'docs'>; }
const {entry} = Astro.props;
const {Content,headings} = await render(entry);
const all = (await getDocsNav()).flatMap(g => g.items);
const index = all.findIndex(i => i.id === entry.id);
---
<DocsLayout title={entry.data.title} description={entry.data.description} headings={headings} prev={all[index-1]} next={all[index+1]}><Content /></DocsLayout>
