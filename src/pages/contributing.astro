---
import BaseLayout from '~/layouts/BaseLayout.astro';

const RULES = [
  'No production security claim before independent test evidence.',
  'Shared features behave the same across signer families.',
  'Display-less smartcards do not provide trusted event review by themselves.',
  'TROPIC01 is not assumed to directly sign Nostr/BIP-340 until proven.',
];
---
<BaseLayout title="Contributing — nSealr" description="How to contribute to nSealr signers, companion, specs, and hardware.">
  <section class="container page">
    <p class="eyebrow">// contributing</p>
    <h1 class="page__title">Contribute to a signer family or the shared spec.</h1>
    <ol class="page__list">
      <li>Pick the repo for the area you want to work on (see <a href="/about/">About</a>).</li>
      <li>Read its <code>README.md</code> for build / test instructions.</li>
      <li>Open issues and PRs that preserve the shared <code>contract_id</code> behavior in <a href="https://github.com/nSealr/specs">nSealr/specs</a> when a feature is present on more than one solution.</li>
    </ol>

    <h2 class="page__h2">Ground rules</h2>
    <ul class="page__list">
      {RULES.map(r => <li>{r}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .page { padding-block: var(--space-20); max-width: 800px; }
  .page__title {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: clamp(28px, 4vw, 40px);
    margin: var(--space-4) 0 var(--space-8);
  }
  .page__h2 {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-3xl);
    margin: var(--space-16) 0 var(--space-6);
  }
  .page__list { display: grid; gap: var(--space-4); max-width: 70ch; padding-left: 1em; }
</style>
