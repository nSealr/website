---
import BaseLayout from '~/layouts/BaseLayout.astro';

const REPOS = [
  { href: 'https://github.com/nSealr/specs', name: 'specs', desc: 'protocol, vectors, signer feature matrix' },
  { href: 'https://github.com/nSealr/companion', name: 'companion', desc: 'host-side software' },
  { href: 'https://github.com/nSealr/raspberry', name: 'raspberry' },
  { href: 'https://github.com/nSealr/esp32', name: 'esp32' },
  { href: 'https://github.com/nSealr/smartcard', name: 'smartcard' },
  { href: 'https://github.com/nSealr/hardware', name: 'hardware' },
  { href: 'https://github.com/nSealr/lab', name: 'lab' },
];
---
<BaseLayout title="About — nSealr" description="About the non-profit open-source nSealr program.">
  <section class="container page">
    <p class="eyebrow">// about</p>
    <h1 class="page__title">nSealr is not a product.</h1>
    <p class="lead">
      It is a non-profit, open-source program for Nostr signing devices,
      companion software, shared specs, and build documentation. The site
      explains the program without turning the core work into a proprietary
      product.
    </p>

    <h2 class="page__h2">Repositories</h2>
    <ul class="page__list">
      {REPOS.map(r => (
        <li><a href={r.href}>{r.name}</a>{r.desc && <> — {r.desc}.</>}</li>
      ))}
    </ul>

    <h2 class="page__h2">License</h2>
    <p>MIT for code. CC0-1.0 for content when published.</p>
  </section>
</BaseLayout>

<style>
  .page { padding-block: var(--space-20); max-width: 800px; }
  .page__title {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-h1);
    margin: var(--space-4) 0 var(--space-8);
  }
  .page__h2 {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-3xl);
    margin: var(--space-16) 0 var(--space-6);
  }
  .lead { font-size: var(--text-xl); }
  .page__list { display: grid; gap: var(--space-4); padding-left: 1em; }
</style>
