---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Callout from '~/components/Callout.astro';

const TRUST_BOUNDARIES = [
  'Private keys must not be exposed to ordinary Nostr clients.',
  'Sensitive signing should require explicit user review where hardware allows it.',
  'The companion is not trusted with key custody.',
  'Maturity differs by signer family — see each family page.',
];
---
<BaseLayout title="Security — nSealr" description="Trust boundaries, threat model overview, and known limits for nSealr signers.">
  <section class="container page">
    <header class="page__head">
      <p class="eyebrow">// security</p>
      <h1 class="page__title">No production security claim yet.</h1>
      <p class="lead">
        nSealr is pre-production research and implementation work. The
        website documents trust boundaries, test evidence, and known limits
        before presenting any device as ready for real keys.
      </p>
    </header>

    <div class="card-grid">
      <article class="surface card">
        <h2 class="card__title">Trust boundaries</h2>
        <ul class="card__list">
          {TRUST_BOUNDARIES.map(t => <li>{t}</li>)}
        </ul>
        <p><a class="link-arrow" href="/docs/security/trust-boundaries/">Deep-dive →</a></p>
      </article>

      <article class="surface card">
        <h2 class="card__title">Current contracts</h2>
        <ul class="card__list">
          <li><code>approval_digest</code> — the local approval is bound to the exact reviewed material.</li>
          <li><code>signing_disabled</code> — real signing is blocked on prototype firmware until hardening gates pass.</li>
          <li><strong>NIP-46 bridge decisions</strong> via <code>nsealr nip46 decide</code> for already-decrypted payloads.</li>
          <li><strong>request-bound capture checks</strong> in <code>nsealr serial-line exchange</code>.</li>
          <li><strong>review detail pages</strong> for long content and tags without truncation.</li>
          <li><strong>T-Display S3 review scenario smoke</strong>, <strong>companion-to-device serial smoke</strong>, <strong>sign-event-disabled smoke</strong>, <strong>firmware protocol evidence</strong>, and <strong>Unicode fallback</strong> tracking — disabled-signing development evidence, not production claims.</li>
        </ul>
      </article>

      <article class="surface card card--wide">
        <h2 class="card__title">Threat model</h2>
        <p class="muted">Adversaries, assets, and assumptions for nSealr signer families.</p>
        <p><a class="link-arrow" href="/docs/security/threat-model/">Read the full threat model →</a></p>
      </article>
    </div>

    <Callout variant="warn" title="Pre-production">
      Do not put production secrets onto current prototypes. Per-solution
      maturity (capability matrix, contract IDs) is in
      <a href="/docs/signers/raspberry-qr/">each family page</a>.
    </Callout>
  </section>
</BaseLayout>

<style>
  .page { padding-block: var(--space-20); }
  .page__head { max-width: 880px; margin-bottom: var(--space-16); }
  .page__title {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-h1);
    line-height: 1.05;
    margin: var(--space-4) 0 var(--space-8);
  }
  .lead { font-size: var(--text-xl); }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-16);
  }
  @media (min-width: 720px) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .card { padding: var(--space-10) var(--space-12); }
  .card--wide { grid-column: span 2; }
  @media (max-width: 720px) { .card--wide { grid-column: span 1; } }

  .card__title {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
  }
  .card__list { display: grid; gap: var(--space-4); padding-left: 1em; margin: 0 0 var(--space-6); }
  .card__list li { font-size: var(--text-base); }
</style>
