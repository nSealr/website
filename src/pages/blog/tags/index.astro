---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV);
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = Array.from(counts.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const alphabetic = Array.from(counts.entries()).sort((a, b) => a[0].localeCompare(b[0]));
const groups = new Map<string, [string, number][]>();
for (const [tag, n] of alphabetic) {
  const key = tag[0].toUpperCase();
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push([tag, n]);
}
---
<BaseLayout title="All tags — nSealr Blog" description="Every tag used in the nSealr blog.">
  <section class="container page">
    <p class="eyebrow">// blog · tags</p>
    <h1 class="page__title">All tags</h1>
    <p class="lead">{tags.length} tags across {posts.length} posts. Most-used first, then alphabetical.</p>

    <h2 class="page__h2">Most used</h2>
    <div class="cluster">
      {tags.slice(0, 24).map(([t, n]) => (
        <a class="chip" href={`/blog/tags/${t}/`}>#{t} <span class="n">{n}</span></a>
      ))}
    </div>

    <h2 class="page__h2">A→Z</h2>
    {Array.from(groups.entries()).map(([letter, items]) => (
      <section class="alpha-group">
        <h3 class="alpha-group__letter">{letter}</h3>
        <div class="cluster">
          {items.map(([t, n]) => (
            <a class="chip" href={`/blog/tags/${t}/`}>#{t} <span class="n">{n}</span></a>
          ))}
        </div>
      </section>
    ))}

    <p class="page__back"><a href="/blog/">← back to blog</a></p>
  </section>
</BaseLayout>

<style>
  .page { padding-block: var(--space-20); }
  .page > .eyebrow,
  .page > .page__title,
  .page > .lead,
  .page > .page__h2,
  .page > .cluster,
  .page > .alpha-group,
  .page > .page__back { max-width: 880px; }

  .page__title {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: clamp(28px, 4vw, 40px);
    margin: var(--space-4) 0 var(--space-6);
  }
  .page__h2 {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-2xl);
    margin: var(--space-16) 0 var(--space-6);
  }
  .lead { font-size: var(--text-lg); margin: 0 0 var(--space-6); }

  .alpha-group { margin-top: var(--space-8); }
  .alpha-group__letter {
    font-family: var(--font-mono);
    color: var(--fg-muted);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: var(--space-6) 0 var(--space-3);
  }

  .page__back { margin-top: var(--space-16); font-family: var(--font-mono); font-size: var(--text-sm); }
</style>
