---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
const steps = [
  ['01', 'Load your identity', 'Create recovery words, enter an nsec, or scan a backup. Check your public identity before use.'],
  ['02', 'Read the request', 'Scan from the companion. See what you are signing, who it affects, and the content.'],
  ['03', 'Return the signature', 'Approve on the device. Scan the response with the companion and return to your client.'],
];
---
<BaseLayout title="nSealr — keep your Nostr key offline" description="An open-source offline Nostr signer. Review on your device and exchange requests and signatures by QR.">
  <Hero />
  <section class="container section">
    <p class="eyebrow">// a clear path</p><h2>Scan. Review. Sign.</h2>
    <div class="steps">{steps.map(([number,title,text]) => <article class="surface"><span class="number">{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
  </section>
  <section class="container section split">
    <div><p class="eyebrow">// less to trust</p><h2>Your key stays<br />with you.</h2></div>
    <div><p class="lead">The connected client prepares the request. The device checks it and calculates the event ID. Your approval applies to that request alone.</p>
      <p class="muted">Use battery power for signing. Keep recovery words and passphrases away from the connected computer.</p>
      <a href="/docs/use/">Read the signing flow →</a></div>
  </section>
  <section class="container section split">
    <div><p class="eyebrow">// fit your client</p><h2>Standard Nostr.<br />Offline signing.</h2></div>
    <div><p class="lead">The companion connects the QR device to clients through browser signing and remote signer methods.</p>
      <p class="muted">NIP-07 in the browser. NIP-46 for remote connections. Normal Nostr events and signatures.</p>
      <a href="/docs/clients/">Connect a client →</a></div>
  </section>
</BaseLayout>
<style>
.section{padding-block:48px}h2{font:600 clamp(28px,4vw,40px)/1.15 var(--font-mono);letter-spacing:-.035em;color:var(--fg-strong);margin:16px 0 28px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.surface{padding:28px;border-radius:6px}.number{font:14px var(--font-mono);color:var(--accent-soft)}
h3{font:600 18px/1.4 var(--font-mono);margin:24px 0 12px}.steps p{color:var(--fg-muted);margin:0;line-height:1.7}
.split{display:grid;grid-template-columns:1fr 1fr;gap:64px;border-top:1px solid var(--border);align-items:start}.split .lead{margin-top:16px}.split a{display:inline-block;margin-top:16px;font-family:var(--font-mono)}
@media(max-width:760px){.steps,.split{grid-template-columns:1fr}.split{gap:8px}.section{padding-block:32px}}
</style>
