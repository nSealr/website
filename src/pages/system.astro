---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SystemMap from '~/components/SystemMap.astro';
import SignerFamilyGrid from '~/components/SignerFamilyGrid.astro';

const SURFACES = [
  { name: 'nsealr CLI', isCode: true, desc: 'request construction, transports, verification, audit export.' },
  { name: 'npm SDK', desc: 'embed the companion in any Nostr client or service.' },
  { name: 'browser extension', desc: 'NIP-07 surface backed by a signer.' },
  { name: 'local app', desc: 'desktop UI for routing and review.' },
  { name: 'local service', desc: 'background daemon for the extension and apps.' },
  { name: 'NIP-46 bridge', desc: 'converts already-decrypted NIP-46 payloads into standard nSealr signing requests.' },
];

const BOUNDARIES = [
  { name: 'Companion', desc: 'secretless routing and verification infrastructure. Not trusted with keys.' },
  { name: 'QR vaults', desc: 'stateless RAM-only session signers.' },
  { name: 'USB/NIP-46', desc: 'future persistent encrypted device-vault signer.' },
  { name: 'Smartcards', desc: 'display-less slot-backed custody — requires external review acknowledgement.' },
  { name: 'Custom wallet', desc: 'research for persistent-secret hardware wallets.' },
];
---
<BaseLayout title="System — nSealr" description="Product shape: one companion and five signer solutions for Nostr signing.">
  <section class="container page">
    <p class="eyebrow">// system</p>
    <h1 class="page__title">One companion. Five signer solutions.</h1>
    <p class="lead">
      The practical product is a shared companion plus five signer solutions,
      not five unrelated experiments. Every shared feature behaves the same
      across implementations because the <code>contract_id</code> in
      <code>nSealr/specs</code> defines it once.
    </p>
    <SystemMap />

    <h2 class="page__h2">Solutions</h2>
    <SignerFamilyGrid />

    <h2 class="page__h2">Companion surfaces</h2>
    <p class="muted">
      The companion is a single TypeScript monorepo that ships multiple
      access surfaces over the same secretless platform. Every surface
      reuses the same validation, transport, and response-verification
      logic.
    </p>
    <ul class="page__list">
      {SURFACES.map(s => (
        <li>
          <strong>{s.isCode ? <code>{s.name}</code> : s.name}</strong> — {s.desc}
        </li>
      ))}
    </ul>

    <h2 class="page__h2">Boundaries</h2>
    <ul class="page__list">
      {BOUNDARIES.map(b => (
        <li><strong>{b.name}:</strong> {b.desc}</li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .page { padding-block: var(--space-20); }
  .page__title {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: var(--space-4) 0 var(--space-10);
  }
  .page__h2 {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-3xl);
    margin: var(--space-16) 0 var(--space-7);
  }
  .lead { font-size: clamp(var(--text-lg), 1.6vw, var(--text-2xl)); max-width: 64ch; }
  .page__list { display: grid; gap: var(--space-4); max-width: 80ch; padding-left: 1em; }
  .page__list code {
    background: var(--accent-bg);
    color: var(--accent-soft);
    padding: 1px var(--space-3);
    border-radius: var(--radius-sm);
    border: 0;
  }
</style>
