---
import BaseLayout from './BaseLayout.astro';
import TagPill from '~/components/TagPill.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import BlogSidebar from '~/components/BlogSidebar.astro';
import PrevNext from '~/components/PrevNext.astro';
import { getEntry } from 'astro:content';

interface Heading { depth: number; slug: string; text: string; }
interface NavItem { href: string; title: string; label?: string; }
interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  tags: string[];
  authorIds: string[];
  ogImage: string;
  headings: Heading[];
  older?: NavItem;
  newer?: NavItem;
}
const {
  title, description, publishedAt, updatedAt, category, tags, authorIds,
  ogImage, headings, older, newer,
} = Astro.props;

const authors = await Promise.all(authorIds.map(id => getEntry('authors', id)));
const authorNames = authors.filter(Boolean).map(a => a!.data.name).join(', ');
const currentHref = Astro.url.pathname;
---
<BaseLayout title={`${title} — nSealr Blog`} description={description} ogImage={ogImage}>
  <div class="post-shell container">
    <BlogSidebar currentHref={currentHref} />

    <article class="post">
      <header class="post__head">
        <p class="post__meta">
          <span class="post__cat">{category}</span>
          <time datetime={publishedAt.toISOString()}>{publishedAt.toISOString().slice(0,10)}</time>
          {authorNames && <span class="post__by">by {authorNames}</span>}
        </p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        {tags.length > 0 && (
          <div class="post__tags">
            {tags.map(t => <TagPill tag={t} href={`/blog/tags/${t}/`} />)}
          </div>
        )}
      </header>
      <div class="prose">
        <slot />
      </div>
      <PrevNext
        prev={older ? { ...older, label: 'Older post' } : undefined}
        next={newer ? { ...newer, label: 'Newer post' } : undefined}
      />
      {updatedAt && (
        <footer class="post__foot">
          <p class="muted">Updated {updatedAt.toISOString().slice(0,10)}</p>
        </footer>
      )}
    </article>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
<style>
  .post-shell {
    display: grid;
    gap: clamp(var(--space-10), 3vw, var(--space-20));
    grid-template-columns: 240px minmax(0, 1fr) 220px;
    align-items: start;
    padding-block: var(--space-14) var(--space-28);
  }
  .post {
    min-width: 0;
    max-width: 720px;
    padding-top: var(--space-6);
  }
  .post__head { margin-bottom: var(--space-14); }
  .post__meta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    display: flex;
    gap: var(--space-7);
    flex-wrap: wrap;
    margin: 0 0 var(--space-5);
  }
  .post__cat { color: var(--accent-soft); text-transform: lowercase; }
  h1 {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    font-size: var(--text-h1);
    line-height: 1.05;
    margin: var(--space-2) 0 var(--space-6);
  }
  .lead { margin: 0 0 var(--space-6); }
  .post__tags { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .post__foot {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    font-size: var(--text-base);
    color: var(--fg-muted);
  }
  @media (max-width: 960px) {
    .post-shell { grid-template-columns: 1fr; }
    .post { max-width: none; }
  }
</style>
