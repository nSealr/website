---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '~/components/DocsSidebar.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import PrevNext from '~/components/PrevNext.astro';
interface Props {
 title:string; description:string; headings:{depth:number;slug:string;text:string}[];
 prev?:{href:string;title:string}; next?:{href:string;title:string};
}
const {title,description,headings,prev,next}=Astro.props;
---
<BaseLayout title={`${title} — nSealr`} description={description}>
 <div class="docs-shell container">
  <DocsSidebar currentHref={Astro.url.pathname} />
  <article class="prose docs-article"><h1>{title}</h1><slot /><PrevNext prev={prev} next={next} /></article>
  <TableOfContents headings={headings} />
 </div>
</BaseLayout>
<style>
  .docs-shell {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 240px minmax(0, 1fr) 220px;
    align-items: start;
    padding-block: var(--space-14);
  }
  .docs-article { padding: var(--space-12) var(--space-4) var(--space-28); min-width: 0; }
  .docs-article__head {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .docs-article__foot {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    font-size: var(--text-base);
    color: var(--fg-muted);
  }
  @media (max-width: 960px) {
    .docs-shell { grid-template-columns: 1fr; }
  }
</style>
