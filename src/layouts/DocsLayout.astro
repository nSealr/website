---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '~/components/DocsSidebar.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import StatusPill from '~/components/StatusPill.astro';
import PrevNext from '~/components/PrevNext.astro';

interface Heading { depth: number; slug: string; text: string; }
interface NavItem { href: string; title: string; label?: string; }
interface Props {
  title: string;
  description: string;
  status?: 'stable' | 'draft' | 'research';
  updatedAt?: Date;
  headings: Heading[];
  prev?: NavItem;
  next?: NavItem;
}
const { title, description, status = 'stable', updatedAt, headings, prev, next } = Astro.props;
const currentHref = Astro.url.pathname;
---
<BaseLayout title={`${title} — nSealr Docs`} description={description}>
  <div class="docs-shell container">
    <DocsSidebar currentHref={currentHref} />
    <article class="prose docs-article">
      <header class="docs-article__head">
        <h1>{title}</h1>
        {status !== 'stable' && <StatusPill variant={status === 'draft' ? 'pending' : 'warn'}>{status}</StatusPill>}
      </header>
      <slot />
      <PrevNext prev={prev} next={next} />
      {updatedAt && (
        <footer class="docs-article__foot">
          <p class="muted">Last updated {updatedAt.toISOString().slice(0, 10)}</p>
        </footer>
      )}
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
<style>
  .docs-shell {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 240px minmax(0, 1fr) 220px;
    align-items: start;
    padding-block: var(--space-14);
  }
  .docs-article { padding: var(--space-12) var(--space-4) var(--space-28); min-width: 0; }
  .docs-article__head {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .docs-article__foot {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    font-size: var(--text-base);
    color: var(--fg-muted);
  }
  @media (max-width: 960px) {
    .docs-shell { grid-template-columns: 1fr; }
  }
</style>
